{
  "name": "ios-dist",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted iOS ad hoc app distribution (OTA installs) over Tailscale",
  "type": "module",
  "bin": {
    "ios-dist": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
